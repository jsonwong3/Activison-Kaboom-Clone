<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>Kaboom</RootNamespace>
    <AssemblyName>Kaboom</AssemblyName>
    <ApplicationIcon>..\KaboomContent\Icons\Kaboom.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <!-- Single-file, self-contained publish: players need nothing installed. -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.2.1105" />
  </ItemGroup>

  <!-- Game assets are embedded in the exe, so there is no Content folder to ship. -->
  <ItemGroup>
    <EmbeddedResource Include="..\KaboomContent\Images\*.png" LogicalName="Images/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\KaboomContent\Sounds\*.wav" LogicalName="Sounds/%(Filename)%(Extension)" />
    <!-- MonoGame uses an embedded "Icon.bmp" as the window (title bar / taskbar) icon. -->
    <EmbeddedResource Include="..\KaboomContent\Icons\Icon.bmp" LogicalName="Icon.bmp" />
  </ItemGroup>

</Project>
